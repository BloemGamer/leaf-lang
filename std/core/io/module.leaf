@use core::prelude::*;

pub struct StdIo { }

impl StdIo {
	fn new() -> Self{return Self{};}
}

impl IO for StdIo {
	fn! print(){}
	fn! println(){}
	fn! eprint(){}
	fn! eprintln(){}
	fn! read(){}
}


@builtin
pub trait IO<Out: Write, Err: Write, In: Read> {
	fn! print();
	fn! println();
	fn! eprint();
	fn! eprintln();
	fn! read();
}

@builtin
trait Write {
	fn! write();
}

@builtin
trait Read {
	fn! read();
}
