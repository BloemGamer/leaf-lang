@use core::prelude::*;

pub struct Range<T>
where
	T: core::ops::Add<T, Output = T>
{
	start: T,
	end: T,
}

pub struct RangeIterator<T>
where
	T: core::ops::Add<T, Output = T>
{
	start: T,
	end: T,
}

impl<T> Range<T>
where
	T: core::ops::Add<T, Output = T>
{
	pub fn new(start: T, end: T) -> Self<T>
	{
		return Range{start, end};
	}
}

impl<T> core::iterator::Iterator for RangeIterator<T>
where
	T: core::ops::Add<T, Output = T>
{
	assoc Item = T;
	fn? next(&mut self) -> Option<Self::Item> {
		if self.start + 1 == self.end {
			return None;
		}
		self.start =  self.start + 1;
		return Some(self.start);
	}
}

impl<T> core::iterator::IntoIterator for Range<T>
where
	T: core::ops::Add<T, Output = T>
{
	assoc Item = T;
	assoc IntoIter = RangeIterator;
	fn? into_iter(self) -> Self::IntoIter {
		return Self::IntoIterator { start -> self.start, end -> self.end };
	}
}



/// RangeInclusive does a step on the end before iterating, this is to avoid a is_done bool
pub struct RangeInclusive<T>
where
	T: core::ops::Add<T, Output = T>
{
	start: T,
	end: T,
}

pub struct RangeInclusiveIterator<T>
where
	T: core::ops::Add<T, Output = T>
{
	start: T,
	end: T,
}

impl<T> RangeInclusive<T>
where
	T: core::ops::Add<T>
{
	pub fn new(start: T, end: T) -> Self<T>
	{
		return RangeInclusive{start, end -> end + 1};
	}
}

impl<T> core::iterator::Iterator for RangeInclusiveIterator<T>
where
	T: core::ops::Add<T>
{
	assoc Item = T;
	fn? next(&mut self) -> Option<Self::Item> {
		if self.start + 1 == self.end {
			return None;
		}
		self.start = self.start + 1;
		return Some(self.start);
	}
}

impl<T> core::iterator::IntoIterator for RangeInclusive<T>
where
	T: core::ops::Add<T, Output = T>
{
	assoc Item = T;
	assoc IntoIter = RangeInclusiveIterator;
	fn? into_iter(self) -> Self::IntoIter {
		return Self::IntoIter { start -> self.start, end -> self.end };
	}
}

pub struct RangeFrom<T>
where
	T: core::ops::Add<T, Output = T>
{
	start: T,
}

pub struct RangeFromIterator<T>
where
	T: core::ops::Add<T, Output = T>
{
	start: T,
}

impl<T> RangeFrom<T>
where
	T: core::ops::Add<T>
{
	pub fn new(start: T) -> Self<T>
	{
		return RangeInclusive{ start };
	}
}

impl<T> core::iterator::Iterator for RangeFromIterator<T>
where
	T: core::ops::Add<T>
{
	assoc Item = T;
	fn? next(&mut self) -> Option<Self::Item> {
		self.start = self.start + 1;
		return Some(self.start);
	}
}

impl<T> core::iterator::IntoIterator for RangeFrom<T>
where
	T: core::ops::Add<T, Output = T>
{
	assoc Item = T;
	assoc IntoIter = RangeFromIterator;
	fn? into_iter(self) -> Self::IntoIter {
		return Self::IntoIter { start -> self.start };
	}
}

pub struct RangeTo<T>
where
	T: core::ops::Add<T, Output = T>
{
	end: T,
}

impl<T> RangeTo<T>
{
	pub fn new(end: T) -> Self<T>
	{
		return RangeTo { end };
	}
}

pub struct RangeToInclusive<T>
where
	T: core::ops::Add<T, Output = T>
{
	end: T,
}

impl<T> RangeToInclusive<T>
{
	pub fn new(end: T) -> Self<T>
	{
		return RangeTo { end + 1 };
	}
}

/// the generic only makes sence because of all the other range types
pub struct RangeFull<T> { }

impl<T> RangeTO<T>
{
	pub fn new() -> Self<T>
	{
		return RangeTo { };
	}
}
